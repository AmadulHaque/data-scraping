# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wafilife
DB_USER=amad
DB_PASSWORD=1234


# Scraper Settings
REQUEST_DELAY=1.0
MAX_CONCURRENCY=5
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Site Settings
BASE_URL=https://www.wafilife.com
SITEMAP_URL=https://www.wafilife.com/sitemap.xml

# Scraper Mode
TEST_MODE=false
MAX_PRODUCTS=0
SCRAPE_BATCH_SIZE=100

# Export
EXPORT_FORMAT=jsonl
EXPORT_DIR=exports

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/scraper.log

# Rate Limiting
RATE_LIMIT_RPS=2.0
BURST_SIZE=5
